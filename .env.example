# Connection to an already provisioned PostgreSQL database.
DATABASE_URL=postgres://USERNAME:PASSWORD@HOST:5432/schtart

# The public origin of this application. Use HTTPS outside local development.
BETTER_AUTH_URL=http://localhost:5173

# Replace with a unique random value, for example: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

# Optional comma-separated exact email addresses. Empty/unset means open registration.
REGISTRATION_EMAIL_ALLOWLIST=
