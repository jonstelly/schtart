# Connection to an already provisioned PostgreSQL database.
DATABASE_URL=postgres://USERNAME:PASSWORD@HOST:5432/schtart

# Disposable database used only by integration, browser, and Docker lifecycle tests.
# It must be a separate database whose name ends with "test"; never use DATABASE_URL here.
TEST_DATABASE_URL=postgres://USERNAME:PASSWORD@HOST:5432/schtart_test

# The public origin of this application. Use HTTPS outside local development.
BETTER_AUTH_URL=http://localhost:5173

# Replace with a unique random value, for example: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

# Password signup and login are enabled by default. Set false for OIDC-only.
PASSWORD_AUTH_ENABLED=true

# Optional single OpenID Connect provider. Set all three values or leave all empty.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional comma-separated exact email addresses. Empty/unset means open registration.
REGISTRATION_EMAIL_ALLOWLIST=
